{
  "name": "indrakusuma-web-id",
  "version": "2.0.0",
  "private": true,
  "description": "Personal website of Indra Kusuma — indrakusuma.web.id",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "next dev",
    "build": "oxlint --deny-warnings && next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "new-post": "node scripts/new-post.mjs",
    "assets": "pnpm assets:icons && pnpm assets:logos && pnpm assets:profile && pnpm assets:favicon && pnpm assets:mark && pnpm assets:posts && pnpm assets:redirects",
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:logos": "node scripts/prepare-company-logos.mjs",
    "assets:profile": "node scripts/optimize-profile.mjs",
    "assets:favicon": "node scripts/generate-favicon.mjs",
    "assets:mark": "node scripts/generate-logo.mjs",
    "assets:posts": "node scripts/prepare-post-images.mjs",
    "assets:redirects": "node scripts/generate-redirects.mjs"
  },
  "dependencies": {
    "@next/third-parties": "16.3.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "gray-matter": "^4.0.3",
    "next-mdx-remote": "^6.0.0",
    "oxlint": "^1.80.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "engines": {
    "node": ">=20.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ],
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.5"
    }
  }
}
